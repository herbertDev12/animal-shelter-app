# Base URL of the NestJS API (apps/api listens on 3002).
VITE_PUBLIC_API_URL=http://localhost:3002

# Name of the cookie holding the JWT.
VITE_PUBLIC_TOKEN_COOKIE_NAME=animal_shelter_token

# Cookie lifetime in seconds. Keep in sync with JWT_EXPIRES_IN in the root .env
# (currently 1d) so the cookie never outlives the token it carries.
VITE_PUBLIC_TOKEN_MAX_AGE=86400
